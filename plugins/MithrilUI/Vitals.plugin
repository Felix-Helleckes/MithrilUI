<?xml version="1.0" encoding="utf-8"?>
<Plugin>
  <Information>
    <Name>MithrilUI Vitals</Name>
    <Author>Felix-Helleckes</Author>
    <Version>0.1.0</Version>
    <Description>Flat morale and power bars for your own character, with a low-morale colour shift. The Lua API exposes no target or fellowship vitals, so this is self only.</Description>
  </Information>
  <Package>MithrilUI.Vitals.Main</Package>
</Plugin>
