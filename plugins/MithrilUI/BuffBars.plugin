<?xml version="1.0" encoding="utf-8"?>
<Plugin>
  <Information>
    <Name>MithrilUI BuffBars</Name>
    <Author>Felix-Helleckes</Author>
    <Version>0.1.0</Version>
    <Description>Your effects as a plain icon grid: buffs and debuffs on separate rows, sorted by remaining time, with a countdown under each icon.</Description>
  </Information>
  <Package>MithrilUI.BuffBars.Main</Package>
</Plugin>
