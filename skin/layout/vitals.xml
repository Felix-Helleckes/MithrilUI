<!--
  Player and target vitals: strip the frame, keep the bars.

  IMPORTANT: this module needs numbers only you can measure.

  Declaring a child element forces you to declare its parent's geometry, and
  the stock size of the vitals panel is not published anywhere. The defaults
  below are a reasonable starting point, not ground truth. If your morale and
  power bars end up the wrong size or in the wrong place, adjust
  `vitalsX/Y/Width/Height` (and the opponent equivalents) in your profile and
  rebuild. See docs/SKINNING.md, "Tuning a layout module".

  This is why the module ships disabled in profiles/default.json.
-->
<PanelFile ID="ID_UISkin_AvatarPanel">

  <Element ID="VitalsParent"
           X="{{ vitalsX }}" Y="{{ vitalsY }}"
           Width="{{ vitalsWidth }}" Height="{{ vitalsHeight }}">

    <Element ID="VitalsField" X="0" Y="0"
             Width="{{ vitalsWidth }}" Height="{{ vitalsHeight }}">

      <!-- @if hideVitalsBackground -->
      <!-- The carved plate behind morale/power. -->
      <Element ID="VitalsBg" X="0" Y="0" Width="1" Height="1"></Element>
      <!-- @endif -->

      <!-- @if hideVitalsAnimations -->
      <!-- Flourish animations that fire on heal / damage. -->
      <Element ID="PlayerVitals_Animations" X="0" Y="0" Width="1" Height="1"></Element>
      <!-- @endif -->

    </Element>

  </Element>

</PanelFile>

<PanelFile ID="ID_UISkin_OpponentPanel">

  <Element ID="OpponentVitalsField"
           X="{{ opponentVitalsX }}" Y="{{ opponentVitalsY }}"
           Width="{{ opponentVitalsWidth }}" Height="{{ opponentVitalsHeight }}">

    <!-- @if hideVitalsBackground -->
    <Element ID="OpponentsVitals_BG" X="0" Y="0" Width="1" Height="1"></Element>
    <!-- @endif -->

    <!-- @if hideVitalsAnimations -->
    <Element ID="OpponentVitals_Animations" X="0" Y="0" Width="1" Height="1"></Element>
    <!-- @endif -->

  </Element>

</PanelFile>
