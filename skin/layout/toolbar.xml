<!--
  Toolbar declutter.

  The main toolbar is the one place where "minimal" means removing things, not
  just repainting them. LOTRO's skin engine has no "hide" verb, so the standard
  community technique is to shrink an element to 1x1 pixels.

  Declaring any child element requires declaring its parent's geometry too,
  which is why this module also positions the toolbar. Defaults reproduce the
  stock placement: horizontally centred, flush to the bottom edge.

  Element IDs below are the real ones used by the game client. If an ID is
  wrong the client silently ignores that line, it does not crash, so a typo
  costs you an unhidden button and nothing worse.

  (XML comments cannot contain a double hyphen. The build fails loudly if one
  sneaks in, so write "and" or a comma instead.)
-->
<PanelFile ID="ID_UISkin_Toolbar">

  <Element ID="ToolbarField"
           X="{{ (screenWidth - toolbarWidth) / 2 }}"
           Y="{{ screenHeight - toolbarHeight }}"
           Width="{{ toolbarWidth }}"
           Height="{{ toolbarHeight }}">

    <Element ID="ToolbarFieldMain" X="0" Y="0"
             Width="{{ toolbarWidth }}" Height="{{ toolbarHeight }}">

      <!-- @if hideLevelMeterGlass -->
      <!-- The glossy overlay on the XP bar. Pure shine, no information. -->
      <Element ID="ToolbarFieldMain_LevelMeter_Glass_Overlay" X="0" Y="0" Width="1" Height="1"></Element>
      <!-- @endif -->

      <!-- @if hideLevelMeterCaps -->
      <!-- Decorative end caps on the XP bar. -->
      <Element ID="ToolbarFieldMain_LevelMeter_Left_Cap" X="0" Y="0" Width="1" Height="1"></Element>
      <Element ID="ToolbarFieldMain_LevelMeter_Mid_Left_Cap" X="0" Y="0" Width="1" Height="1"></Element>
      <Element ID="ToolbarFieldMain_LevelMeter_Mid_Right_Cap" X="0" Y="0" Width="1" Height="1"></Element>
      <Element ID="ToolbarFieldMain_LevelMeter_Right_Cap" X="0" Y="0" Width="1" Height="1"></Element>
      <!-- @endif -->

    </Element>

    <!-- @if hideWebstoreButton -->
    <!-- The LOTRO Store button. -->
    <Element ID="Toolbar_WebstoreButton" X="0" Y="0" Width="1" Height="1"></Element>
    <!-- @endif -->

    <!-- @if hideLeftSlots -->
    <!-- Left-hand toolbar buttons. Everything here has a keybind. -->
    <Element ID="ToolbarButton_Slot_1" X="0" Y="0" Width="1" Height="1">
      <Element ID="CustomizableSlotButton_BuyNowButton" X="0" Y="0" Width="1" Height="1"></Element>
    </Element>
    <Element ID="ToolbarButton_Slot_2" X="0" Y="0" Width="1" Height="1"></Element>
    <Element ID="ToolBarButton_Slot_3" X="0" Y="0" Width="1" Height="1"></Element>
    <Element ID="ToolbarButton_Slot_4" X="0" Y="0" Width="1" Height="1"></Element>
    <Element ID="ToolbarButton_Slot_5" X="0" Y="0" Width="1" Height="1"></Element>
    <Element ID="ToolBarButton_Slot_6" X="0" Y="0" Width="1" Height="1"></Element>
    <Element ID="ToolbarButton_Slot_7" X="0" Y="0" Width="1" Height="1"></Element>
    <!-- @endif -->

    <!-- @if hideRightSlots -->
    <!-- Right-hand toolbar buttons (bags, character, social, ...). -->
    <Element ID="ToolbarButton_RightSlot_1" X="0" Y="0" Width="1" Height="1"></Element>
    <Element ID="ToolBarButton_RightSlot_2" X="0" Y="0" Width="1" Height="1"></Element>
    <Element ID="ToolBarButton_RightSlot_3" X="0" Y="0" Width="1" Height="1"></Element>
    <Element ID="ToolBarButton_RightSlot_4" X="0" Y="0" Width="1" Height="1"></Element>
    <Element ID="ToolBarButton_RightSlot_5" X="0" Y="0" Width="1" Height="1"></Element>
    <Element ID="ToolBarButton_RightSlot_6" X="0" Y="0" Width="1" Height="1"></Element>
    <Element ID="ToolBarButton_RightSlot_7" X="0" Y="0" Width="1" Height="1"></Element>
    <Element ID="ToolBarButton_RightSlot_8" X="0" Y="0" Width="1" Height="1"></Element>
    <!-- @endif -->

    <!-- @if hideMainMenuButton -->
    <Element ID="ToolBarButton_MainMenu" X="0" Y="0" Width="1" Height="1"></Element>
    <!-- @endif -->

  </Element>

</PanelFile>
