# themes/ + skin/ + profiles/, so there is no reason to track them.
dist/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.mypy_cache/
.ruff_cache/

# Editors
.vscode/
.idea/
*.swp

# OS
Thumbs.db
desktop.ini
.DS_Store
